{
  "name": "devart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevArt: create architecture diagrams in the browser. Serverless: a Vite app on Vercel with Supabase for login and storage.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
